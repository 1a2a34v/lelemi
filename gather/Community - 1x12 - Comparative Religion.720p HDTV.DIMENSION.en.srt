- 'Sup, man?

401
00:16:02,137 --> 00:16:03,370
- 'Sup?
- 'Sup?

402
00:16:03,438 --> 00:16:04,772
- 'Sup? 'Sup?
- 'Sup? 'Sup?

403
00:16:04,839 --> 00:16:06,607
- 'Sup? 'Sup?
- 'Sup? 'Sup?

404
00:16:06,674 --> 00:16:08,675
'Sup? 'Sup?

405
